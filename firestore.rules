rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an administrator
    function isAdmin() {
      return request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Public businesses collection
    match /businesses/{businessId} {
      // Public can read only approved businesses
      allow read: if resource.data.status == 'approved' || isAdmin();
      // Anyone can submit a new business with status: 'pending'
      allow create: if request.resource.data.status == 'pending';
      // Only admins can approve, reject, or modify existing businesses
      allow update, delete: if isAdmin();
    }

    // Contact messages collection
    match /contact_messages/{messageId} {
      // Public can submit contact messages
      allow create: if request.resource.data.name != null && request.resource.data.email != null;
      // Only admins can read, update, or delete contact messages
      allow read, update, delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

  }
}
