rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read, create, update, and delete access for business listings
    match /businesses/{businessId} {
      allow read, write: if true;
    }

    // Professional directory & verifications
    match /professionals/{professionalId} {
      allow read, write: if true;
    }

    match /professional_verifications/{verificationId} {
      allow read, write: if true;
    }

    match /professional_inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Jobs and Employers
    match /jobs/{jobId} {
      allow read, write: if true;
    }

    match /companies/{companyId} {
      allow read, write: if true;
    }

    match /job_applications/{applicationId} {
      allow read, write: if true;
    }

    // Contact messages collection
    match /contact_messages/{messageId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }

  }
}
